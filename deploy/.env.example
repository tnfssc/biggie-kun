# Cloudflare Tunnel token whose public hostname targets http://biggie-kun:11500
CLOUDFLARED_TUNNEL_TOKEN=

# Ollama on the host. Rootless Docker often cannot use host-gateway;
# use the host LAN IP (or hostname) that containers can reach.
OLLAMA_HOST=http://192.168.0.93:11434

# Controller model pulled into host Ollama
BIGGIE_MODEL=rwkv7-7.2b-10m:latest
